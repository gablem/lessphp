{
	"name": "gablem/lessphp",
	"type": "library",
	"description": "lessphp is a compiler for LESS written in PHP.",
	"homepage": "http://leafo.net/lessphp/",
	"license": [
		"MIT",
		"GPL-3.0"
	],
	"authors": [
		{
			"name": "Leaf Corcoran",
			"email": "leafot@gmail.com",
			"homepage": "http://leafo.net"
		},
		{
			"name": "Gabriel Lemonde-Labrecque",
			"email": "gabriel@gablem.com"
		}
	],
	"bin": [
		"plessc",
		"lessify"
	],
	"require": {
		"php": ">=7.4"
	},
	"autoload": {
		"classmap": ["lessc.inc.php"]
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.7"
	},
	"scripts": {
		"test": [
			"phpunit",
			"phpcs -p -s"
		],
		"fix": "phpcbf"
	}
}
